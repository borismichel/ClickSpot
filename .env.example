DAGSTER_HOME=.dagster_home

# HUBSPOT_TOKEN is OPTIONAL. Leave it blank to run fully offline against the
# bundled synthetic warehouse — load it with `make seed` (or
# `python scripts/seed.py`), which populates bronze -> silver -> gold -> anon
# directly from demo-data/clickspot-demo-data.csv. Set it only to extract from a
# live HubSpot portal; bronze API assets fail with a clear pointer to the seed
# loader when it is unset.
HUBSPOT_TOKEN=
HUBSPOT_HUB_ID=
# Optional. Region code (na1, eu1, na2, ...) used to build correct HubSpot
# click-through URLs in chat results and MCP responses. Auto-detected from
# HUBSPOT_TOKEN on the first bronze API call and cached in
# ~/.clickspot/customer.json; only set this explicitly if running MCP without
# the token, or if auto-detection got it wrong.
# HUBSPOT_REGION=eu1

# ClickHouse mode. Leave unset to auto-pick per platform: the docker-free native
# binary on Linux, the ClickHouse container (docker-compose.yml) on macOS/Windows
# where the binary can't be auto-installed. Override explicitly with one of:
#   local    — docker-free native binary (Linux, or set CLICKHOUSE_BIN yourself)
#   docker   — ClickHouse container via docker-compose.yml
#   external — you manage ClickHouse yourself
# CLICKSPOT_CLICKHOUSE_MODE=docker
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=hs2ch
CLICKHOUSE_PASSWORD=hs2ch
# Per-query wall-clock cap (seconds) for the interactive read path — chat, SQL
# editor, Data Spaces, MCP. Bounds a runaway query so it fails fast instead of
# holding the 2 GB memory cap. Does not affect the Dagster pipeline. Set to 0
# to disable. Default 60.
# CLICKHOUSE_MAX_EXECUTION_TIME=60
