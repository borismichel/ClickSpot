DAGSTER_HOME=.dagster_home

HUBSPOT_TOKEN=your-private-app-token-here
HUBSPOT_HUB_ID=your-hub-id-here
# Optional. Region code (na1, eu1, na2, ...) used to build correct HubSpot
# click-through URLs in chat results and MCP responses. Auto-detected from
# HUBSPOT_TOKEN on the first bronze API call and cached in
# ~/.clickspot/customer.json; only set this explicitly if running MCP without
# the token, or if auto-detection got it wrong.
# HUBSPOT_REGION=eu1

# ClickHouse — standalone container (docker-compose.yml)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=hs2ch
CLICKHOUSE_PASSWORD=hs2ch
