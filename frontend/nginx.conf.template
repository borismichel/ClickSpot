# Rendered to /etc/nginx/conf.d/default.conf at container start: the nginx image
# runs envsubst over ${BACKEND_ORIGIN}. nginx runtime variables ($host, $uri,
# $remote_addr, ...) are not in the environment, so envsubst leaves them intact.
server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Don't cache the entry document — it references hashed asset filenames.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Hashed build assets are immutable; cache them hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # API + health are owned by the FastAPI backend.
    location /api/ {
        proxy_pass         ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Chat/LLM round-trips can take a while; give them room.
        proxy_read_timeout 600s;
    }

    location = /health {
        proxy_pass       ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
    }

    # SPA fallback — client-side routes resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
